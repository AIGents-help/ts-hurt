# All set in Vercel → ts-hurt → Settings → Environment Variables (Production). Never commit real values.

# --- Payments (NEW Ts-Hurt-only Stripe account) ---
STRIPE_SECRET_KEY=            # sk_live_... (run scripts/setup-stripe.mjs once with it)
STRIPE_WEBHOOK_SECRET=        # whsec_... printed by scripts/setup-stripe.mjs
STRIPE_AUTOMATIC_TAX=false    # true after enabling Stripe Tax + registering states

# --- Fulfillment (Printful) ---
PRINTFUL_API_TOKEN=           # Printful → Settings → API → private token (orders + catalog scopes)
PRINTFUL_STORE_ID=            # only if the token is account-level
PRINTFUL_AUTO_CONFIRM=false   # flip to true after your first sample order looks right

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=           # list that the popup feeds + drop broadcasts go to
EMAIL_FROM=TS-HURT <orders@ts-hurt.com>
OWNER_EMAIL=                  # where sale alerts + weekly report go
WELCOME_PROMO_CODE=WELCOME10
RECOVERY_PROMO_CODE=COMEBACK10

# --- Command Center / automation ---
ADMIN_PASSWORD=               # /admin login (any username)
METRICS_TOKEN=                # bearer token for /api/metrics (DJINN, Brand Command Center)
CRON_SECRET=                  # Vercel sends this to cron routes automatically once set

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://ts-hurt.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@ts-hurt.com
